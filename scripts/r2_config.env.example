# Cloudflare R2 credentials for match upload
# Copy this file to r2_config.env and fill in your values.
# r2_config.env is gitignored and will never be committed.

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY=your-access-key-id
R2_SECRET_KEY=your-secret-access-key

# Local folder containing match recordings (each subfolder has an infos.json)
MATCH_SOURCE_DIR=~/Documents/MatchDirectory

# After successful upload, move match folders here to free source disk space
# Leave empty or remove to keep matches in place
POST_UPLOAD_ARCHIVE_DIR=D:\MatchArchive

# GWToolbox recording output directory. If set, completed recordings
# are automatically collected into MATCH_SOURCE_DIR before uploading.
# Leave empty to skip collection (manual workflow).
RECORDING_SOURCE_DIR=%APPDATA%/GWToolboxpp/GwReplayRecorder

# Path to orchestrator database. If set, corrupt recordings are reset
# so the orchestrator re-records them on the next session.
ORCHESTRATOR_DB=~/Documents/gw-observer-orchestrator/orchestrator.db

# Match validation: corrupt recordings are moved to MATCH_SOURCE_DIR/rejected/
# Uncomment to override defaults (validation runs automatically if validate_match.py exists)
# VALIDATE_P95_THRESHOLD=50.0

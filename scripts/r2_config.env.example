# Cloudflare R2 credentials for match upload
# Copy this file to r2_config.env and fill in your values.
# r2_config.env is gitignored and will never be committed.

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY=your-access-key-id
R2_SECRET_KEY=your-secret-access-key

# Local folder containing match recordings (each subfolder has an infos.json)
MATCH_SOURCE_DIR=C:\path\to\local\match\cache

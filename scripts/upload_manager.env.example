# Upload Manager configuration
# Copy this file to upload_manager.env and fill in your values.
# upload_manager.env is gitignored and will never be committed.

# Discord webhook URL for notifications (required for alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Python executable (default: python)
PYTHON_EXE=python

# Log directory (default: scripts/logs/)
LOG_DIR=

# Days to keep log files (default: 30)
LOG_RETENTION_DAYS=30

# Scheduled task interval in minutes (default: 60)
TASK_INTERVAL_MINUTES=60

# Send Discord notification on successful uploads too (default: false)
# Failure and recovery notifications are always sent when webhook is configured.
NOTIFY_ON_SUCCESS=false
